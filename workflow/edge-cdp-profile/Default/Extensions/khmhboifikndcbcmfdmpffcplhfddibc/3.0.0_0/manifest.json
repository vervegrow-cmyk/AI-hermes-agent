{
   "action": {
      "default_icon": {
         "19": "assets/images/logo.png",
         "38": "assets/images/logo.png"
      },
      "default_popup": "popup.html",
      "default_title": "登录Helium10"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "css": [ "assets/css/stylee.css" ],
      "js": [ "assets/js/jquery-3.6.0.min.js", "ft.js" ],
      "matches": [ "https://*.helium10.com/*", "https://*.freedomticket.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval' ; object-src 'self'"
   },
   "description": "跨境卖家的好帮手",
   "host_permissions": [ "https://*.helium10.com/*", "https://*.freedomticket.com/*" ],
   "icons": {
      "128": "assets/images/logo.png",
      "16": "assets/images/logo.png",
      "48": "assets/images/logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "H10登录器",
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [ "cookies", "tabs", "management", "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "3.0.0"
}
