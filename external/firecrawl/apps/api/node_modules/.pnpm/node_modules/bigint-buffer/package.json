{
  "name": "four-flap-bigint-buffer",
  "version": "1.1.6",
  "description": "Fork of bigint-buffer with security hardening (drop-in replacement via npm overrides)",
  "main": "dist/node.js",
  "browser": {
    "./dist/node.js": "./dist/browser.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/bigint-buffer.c",
    "binding.gyp",
    "helper/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install": "npm run rebuild || echo \"Couldn't build bindings. Non-native version used.\"",
    "rebuild": "node-gyp rebuild",
    "prepublishOnly": "rm -rf build/Release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/no2chem/bigint-buffer.git"
  },
  "bugs": {
    "url": "https://github.com/no2chem/bigint-buffer/issues"
  },
  "keywords": [
    "bigint",
    "bignum",
    "tc39-bigint",
    "napi"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "bindings": "^1.3.0"
  },
  "engines": {
    "node": ">= 10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    "Michael Wei <mwei@vmware.com> (https://github.com/no2chem)"
  ]
}
